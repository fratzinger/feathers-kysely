{
  "name": "@fratzinger/feathers-kysely",
  "description": "Feathers SQL service adapter using Kysely",
  "version": "0.13.2",
  "homepage": "https://github.com/fratzinger/feathers-kysely",
  "keywords": [
    "feathers",
    "feathers-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fratzinger/feathers-kysely.git"
  },
  "author": {
    "name": "Frederik Schmatz"
  },
  "contributors": [],
  "bugs": {
    "url": "https://github.com/fratzinger/feathers-kysely/issues"
  },
  "engines": {
    "node": ">= 24"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "version": "pnpm build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint",
    "vitest": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@feathersjs/adapter-commons": "^5.0.50",
    "@feathersjs/commons": "^5.0.50",
    "@feathersjs/errors": "^5.0.50",
    "@feathersjs/feathers": "^5.0.50",
    "feathers-utils": "^10.9.2"
  },
  "devDependencies": {
    "@feathers-community/eslint-config": "^0.3.0",
    "@feathersjs/transport-commons": "^5.0.50",
    "@tsconfig/node22": "^22.0.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.4",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.12.0",
    "feathers-adapter-vitest": "^0.3.0",
    "kysely": "^0.29.6",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "shx": "^0.4.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vite": "^8.3.4",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@feathersjs/feathers": "^5.0.0",
    "kysely": ">=0.28.0 <0.30.0"
  },
  "packageManager": "pnpm@12.11.2"
}
