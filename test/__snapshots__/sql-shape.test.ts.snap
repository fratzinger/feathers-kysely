exports[`sql shape > $not with relation path 1`] = `
{
  "parameters": [
    "a-1",
    25,
  ],
  "sql": "select "events".* from "events" where not exists (select 1 from "assignments" as "assignment" where ("assignment"."id" = "events"."assignmentId" and "assignment"."title" = ?)) order by "events"."id" asc limit ?",
}
`;

